# Token Trail local development settings
# Copy to .env for machine-specific overrides. Do not commit .env.

# Demo identity
DEMO_NAME=token-trail
DEMO_MODE=development

# Shared model list and default model selection.
TOKEN_TRAIL_MODEL_CONFIG_PATH=config/models.json

# Initial selected backend.
# Options:
# - scripted: explicit prepared token replay; no model server required.
# - modeldeck: replayable live token trace through externally managed ModelDeck workers.
TOKEN_TRAIL_BACKEND=modeldeck

# Current single-process demo service.
TOKEN_TRAIL_HOST=127.0.0.1
TOKEN_TRAIL_PORT=3100

# Reserved future Token Trail backend/API port.
# Use this when the frontend and backend are split.
TOKEN_TRAIL_BACKEND_PORT=8100
TOKEN_TRAIL_BACKEND_URL=http://127.0.0.1:8100

# Shared local services reserved by the Open Day port map.
TOKEN_TRAIL_MODELDECK_URL=http://127.0.0.1:8600
TOKEN_TRAIL_REPLAY_SERVICE_URL=http://127.0.0.1:8700

# ModelDeck owns route configuration, provider selection and lifecycle. Token Trail only
# discovers the configured public routes and calls the stable native trace endpoint.
TOKEN_TRAIL_MODELDECK_ENABLED=true
TOKEN_TRAILS_MODEL=qwen-1-5b
TOKEN_TRAIL_MODELDECK_MODELS=qwen-0-5b,qwen-1-5b,qwen-3b
TOKEN_TRAIL_MODELDECK_TOP_K=5
TOKEN_TRAIL_MODELDECK_MAX_NEW_TOKENS=64
TOKEN_TRAIL_MODELDECK_TEMPERATURE=0.3
TOKEN_TRAIL_MODELDECK_TIMEOUT_SECONDS=20
TOKEN_TRAIL_MODELDECK_INSTRUCTIONS_FILE=config/instructions/modeldeck_default.txt
